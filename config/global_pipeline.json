{
  "schema_version": 1,
  "output_root": "outputs/global",
  "block_epochs": 16,
  "embedding_dimension": 6,
  "delay_samples": 1,
  "bout_threshold_percentile": 95.0,
  "bout_minimum_cycles": 3.0,
  "fdr_alpha": 0.05,
  "bands": {
    "delta": [1.0, 4.0],
    "theta": [4.0, 8.0],
    "alpha": [8.0, 13.0],
    "beta": [13.0, 30.0],
    "gamma": [30.0, 50.0]
  },
  "datasets": [
    {
      "id": "primary",
      "root": ".",
      "metadata": "processed/metadata/subjects.csv",
      "epochs_dir": "processed/epochs",
      "epoch_glob": "sub-*_task-Rest_desc-cleaned_epo.fif",
      "columns": {
        "group": "GROUP",
        "age_years": "AGE",
        "sex": "GENDER",
        "updrs": "UPDRS",
        "moca": "MOCA",
        "mmse": "MMSE"
      }
    },
    {
      "id": "medication_state",
      "root": ".",
      "metadata": "processed_ds002778/metadata/subjects.csv",
      "epochs_dir": "processed_ds002778/epochs",
      "epoch_glob": "sub-*_ses-*_task-rest_desc-cleaned_epo.fif",
      "columns": {
        "group": "GROUP",
        "age_years": "AGE",
        "sex": "GENDER",
        "updrs": "UPDRS",
        "moca": "MOCA",
        "mmse": "MMSE"
      }
    },
    {
      "id": "dataset_3",
      "enabled": true,
      "root": "path/to/dataset_3",
      "metadata": "path/to/dataset_3/participants.tsv",
      "epochs_dir": "path/to/dataset_3/processed/epochs",
      "epoch_glob": "sub-*_task-rest_desc-cleaned_epo.fif"
    },
    {
      "id": "dataset_4",
      "enabled": true,
      "root": "path/to/dataset_4",
      "metadata": "path/to/dataset_4/participants.tsv",
      "epochs_dir": "path/to/dataset_4/processed/epochs",
      "epoch_glob": "sub-*_task-rest_desc-cleaned_epo.fif"
    }
  ]
}

{
  "input": {
    "participants_file": "processed/metadata/subjects.csv",
    "ordinal_electrode_file": "outputs/full/ordinal/metrics/electrode_metrics.csv",
    "ordinal_band_electrode_file": "outputs/full/ordinal/metrics/band_electrode_metrics.csv",
    "ordinal_electrode_sets_file": "outputs/full/ordinal/metrics/electrode_sets.json",
    "psd_electrode_file": "outputs/full/psd/metrics/subject_electrode_band_power.csv",
    "aperiodic_electrode_file": "outputs/full/scale_free/metrics/electrode_aperiodic_metrics.csv",
    "bout_electrode_file": "outputs/full/scale_free/metrics/electrode_band_metrics.csv",
    "bout_ordinal_electrode_file": "outputs/full/bouts/metrics/subject_electrode_band_metrics.csv",
    "epoch_example_glob": "processed/epochs/sub-*_task-Rest_desc-cleaned_epo.fif"
  },
  "output_dir": "outputs/full/progression",
  "electrode_scope": {
    "policy": "all_cohort_shared_electrodes",
    "expected_count": 60
  },
  "analysis": {
    "group": "PD",
    "primary_outcome": "updrs",
    "secondary_outcomes": ["moca"],
    "cognitive_status": {
      "impairment_below": 26,
      "normal_range": [26, 30]
    },
    "covariates": ["age_years", "sex_male"],
    "minimum_subjects": 30,
    "bootstrap_resamples": 1000,
    "bootstrap_confidence_level": 0.95,
    "random_seed": 20260826,
    "fdr_alpha": 0.05,
    "fdr_scope": "within_outcome_feature_family_and_method"
  },
  "features": {
    "ordinal_metrics": [
      "entropy", "weighted_permutation_entropy", "complexity", "fisher_information",
      "renyi_entropy_alpha_0_1", "renyi_complexity_alpha_0_1",
      "renyi_entropy_alpha_0_5", "renyi_complexity_alpha_0_5",
      "renyi_entropy_alpha_0_9", "renyi_complexity_alpha_0_9",
      "renyi_entropy_alpha_1_1", "renyi_complexity_alpha_1_1",
      "renyi_entropy_alpha_2", "renyi_complexity_alpha_2",
      "renyi_entropy_alpha_5", "renyi_complexity_alpha_5",
      "renyi_entropy_alpha_10", "renyi_complexity_alpha_10"
    ],
    "ordinal_bands": ["delta", "theta", "alpha", "beta", "gamma"],
    "psd_metric": "relative_band_power",
    "psd_bands": ["delta", "theta", "alpha", "beta", "gamma"],
    "aperiodic_metrics": ["aperiodic_exponent", "aperiodic_exponent_qc"],
    "minimum_aperiodic_qc_fraction": 0.8,
    "bout_bands": ["theta", "alpha", "beta", "gamma"],
    "bout_properties": [
      "oscillatory_occupancy", "bouts_per_minute", "bout_duration_mean_s",
      "bout_cycles_mean", "bout_snr_mean"
    ],
    "bout_ordinal_metrics": ["entropy", "weighted_permutation_entropy", "complexity", "fisher_information"],
    "embedding_dimension": 6,
    "delay_samples": 1
  },
  "plots": {
    "dpi": 150,
    "features_per_page": 9,
    "updrs_color": "#D55E00",
    "moca_color": "#0072B2",
    "significant_color": "#009E73"
  }
}

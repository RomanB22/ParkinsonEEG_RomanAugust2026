{
  "input": {
    "epochs_dir": "processed/epochs",
    "epoch_glob": "sub-*_task-Rest_desc-cleaned_epo.fif",
    "participants_file": "processed/metadata/subjects.csv",
    "scale_free_output_dir": "outputs/full/scale_free"
  },
  "output_dir": "outputs/full/bouts",
  "bands": {
    "theta": [4.0, 8.0],
    "alpha": [8.0, 13.0],
    "beta": [13.0, 30.0],
    "gamma": [30.0, 50.0]
  },
  "psd": {
    "fmin_hz": 1.0,
    "fmax_hz": 50.0
  },
  "specparam": {
    "aperiodic_mode": "best_bic",
    "aperiodic_modes": ["fixed", "knee"],
    "model_selection_criterion": "bic",
    "frequency_range_hz": [4.0, 50.0],
    "knee_frequency_outlier_z_threshold": 2.0,
    "peak_width_limits_hz": [1.0, 12.0],
    "max_n_peaks": 8,
    "min_peak_height": 0.0,
    "peak_threshold": 2.0
  },
  "ebosc": {
    "frequency_min_hz": 4.0,
    "frequency_max_hz": 50.0,
    "frequency_step_hz": 1.0,
    "wavenumber": 6.0,
    "power_percentile": 0.95,
    "minimum_cycles": 3.0,
    "edge_padding_seconds": 0.75
  },
  "ordinal": {
    "embedding_dimension": 6,
    "delay_samples": 1,
    "tie_precision": null,
    "signal": "bandpass_filtered_cleaned_eeg_within_detected_bouts",
    "pooling": "pool_pattern_counts_without_crossing_bout_or_epoch_boundaries"
  },
  "band_filter": {
    "method": "butterworth_sos_sosfiltfilt",
    "order": 4,
    "phase": "zero_phase",
    "boundary_policy": "filter_each_accepted_epoch_before_slicing_bouts"
  },
  "cache": {
    "reuse_scale_free_detection": true,
    "link_reused_episode_and_threshold_files": true
  },
  "statistics": {
    "fdr_alpha": 0.05,
    "confidence_level": 0.95,
    "subject_aggregation": "mean",
    "exclude_bands": []
  },
  "plots": {
    "dpi": 150,
    "group_order": ["PD", "Control"],
    "group_colors": {"PD": "#D55E00", "Control": "#0072B2"},
    "band_display_names": {
      "theta": "Theta",
      "alpha": "Alpha",
      "beta": "Beta",
      "gamma": "Gamma"
    },
    "subject_topomaps": true
  }
}

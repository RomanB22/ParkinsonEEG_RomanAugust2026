{
  "input": {
    "epochs_dir": "processed/epochs",
    "epoch_glob": "sub-*_task-Rest_desc-cleaned_epo.fif",
    "participants_file": "processed/metadata/subjects.csv"
  },
  "output_dir": "outputs/full/ordinal",
  "ordinal": {
    "embedding_dimension": 6,
    "delay_samples": 1,
    "tie_precision": null
  },
  "bands": {
    "delta": [
      1.0,
      4.0
    ],
    "theta": [
      4.0,
      8.0
    ],
    "alpha": [
      8.0,
      13.0
    ],
    "beta": [
      13.0,
      30.0
    ],
    "low_gamma": [
      30.0,
      50.0
    ]
  },
  "band_filter": {
    "method": "butterworth_sos_sosfiltfilt",
    "order": 4,
    "phase": "zero_phase",
    "epoch_boundary_policy": "filter_each_accepted_epoch_independently"
  },
  "statistics": {
    "fdr_alpha": 0.05,
    "confidence_level": 0.95,
    "subject_aggregation": "mean",
    "exclude_bands": []
  },
  "plots": {
    "dpi": 150,
    "channels_per_plane_page": 12,
    "subject_topomaps": false,
    "group_order": [
      "PD",
      "Control"
    ],
    "group_colors": {
      "PD": "#D55E00",
      "Control": "#0072B2"
    },
    "band_display_names": {
      "delta": "Delta",
      "theta": "Theta",
      "alpha": "Alpha",
      "beta": "Beta",
      "low_gamma": "Low gamma"
    }
  }
}

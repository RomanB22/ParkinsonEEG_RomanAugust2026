{
  "input": {
    "participants_file": "processed/metadata/subjects.csv",
    "ordinal_global_file": "ordinal_analysis/processed/metrics/subject_electrode_mean_metrics.csv",
    "ordinal_band_file": "ordinal_analysis/processed/metrics/band_subject_electrode_mean_metrics.csv",
    "psd_subject_band_file": "psd_analysis/processed/metrics/subject_band_power.csv",
    "aperiodic_subject_file": "scale_free_analysis/processed/metrics/subject_aperiodic_metrics.csv",
    "bout_subject_file": "scale_free_analysis/processed/metrics/subject_band_metrics.csv",
    "bout_ordinal_subject_file": "bout_analyses/processed/metrics/subject_band_metrics.csv",
    "typical_bout_file": "scale_free_analysis/processed/intermediate/typical_bouts/subject_electrode_band_envelopes.npz",
    "ordinal_sweep_root": "ordinal_analysis/parameter_sweep"
  },
  "output_dir": "exploration/processed",
  "demographic_matching": {
    "output_dir": "exploration/processed_matched",
    "exact_variables": ["sex_male"],
    "distance_variable": "age_years",
    "algorithm": "optimal_linear_sum_assignment_without_replacement_within_sex",
    "maximum_age_difference_years": 5.0
  },
  "primary_ordinal_parameters": {
    "embedding_dimension": 6,
    "delay_samples": 1
  },
  "ordinal_sweep": {
    "expected_dimensions": [3, 4, 5, 6],
    "expected_delays": [1]
  },
  "ordinal_model_bands": ["theta", "alpha", "beta"],
  "candidate_features": {
    "renyi_metrics": [
      "renyi_entropy_alpha_0_1",
      "renyi_complexity_alpha_0_1",
      "renyi_entropy_alpha_10",
      "renyi_complexity_alpha_10"
    ],
    "renyi_policy": "Prespecified low/high alpha endpoints only; intermediate alphas are excluded from models because of extreme rank redundancy",
    "bout_bands": ["theta", "alpha", "low_beta", "high_beta"],
    "bout_metrics": ["oscillatory_occupancy", "bouts_per_minute", "bout_duration_mean_s"],
    "bout_ordinal_metrics": ["entropy", "complexity", "fisher_information"],
    "typical_bout_summaries": ["envelope_peak_ratio", "envelope_half_height_width_s", "envelope_asymmetry", "relative_phase_consistency"]
  },
  "psd_log_ratio": {
    "numerator_bands": ["delta", "theta", "alpha", "beta"],
    "reference_band": "low_gamma",
    "log_base": 2
  },
  "models": {
    "demographics": {
      "label": "Demographics",
      "role": "baseline",
      "features": ["age_years", "sex_male"]
    },
    "ordinal_core": {
      "label": "Ordinal H/C/F",
      "role": "primary_unadjusted",
      "features": ["ordinal_global_entropy", "ordinal_global_complexity", "ordinal_global_fisher_information"]
    },
    "ordinal_adjusted": {
      "label": "Ordinal H/C/F + demographics",
      "role": "primary",
      "features": ["age_years", "sex_male", "ordinal_global_entropy", "ordinal_global_complexity", "ordinal_global_fisher_information"]
    },
    "ordinal_renyi_adjusted": {
      "label": "Ordinal + Rényi endpoints + demographics",
      "role": "renyi_sensitivity",
      "features": ["age_years", "sex_male", "ordinal_global_entropy", "ordinal_global_complexity", "ordinal_global_fisher_information", "ordinal_global_renyi_entropy_alpha_0_1", "ordinal_global_renyi_complexity_alpha_0_1", "ordinal_global_renyi_entropy_alpha_10", "ordinal_global_renyi_complexity_alpha_10"]
    },
    "psd_adjusted": {
      "label": "PSD + demographics",
      "role": "secondary",
      "features": ["age_years", "sex_male", "psd_log2_delta_vs_low_gamma", "psd_log2_theta_vs_low_gamma", "psd_log2_alpha_vs_low_gamma", "psd_log2_beta_vs_low_gamma"]
    },
    "ordinal_psd_adjusted": {
      "label": "Ordinal + PSD + demographics",
      "role": "secondary",
      "features": ["age_years", "sex_male", "ordinal_global_entropy", "ordinal_global_complexity", "ordinal_global_fisher_information", "psd_log2_delta_vs_low_gamma", "psd_log2_theta_vs_low_gamma", "psd_log2_alpha_vs_low_gamma", "psd_log2_beta_vs_low_gamma"]
    },
    "ordinal_band_adjusted": {
      "label": "Band ordinal + demographics",
      "role": "sensitivity",
      "features": ["age_years", "sex_male", "ordinal_theta_entropy", "ordinal_theta_complexity", "ordinal_theta_fisher_information", "ordinal_alpha_entropy", "ordinal_alpha_complexity", "ordinal_alpha_fisher_information", "ordinal_beta_entropy", "ordinal_beta_complexity", "ordinal_beta_fisher_information"]
    },
    "ordinal_band_renyi_adjusted": {
      "label": "Band ordinal + Rényi endpoints + demographics",
      "role": "renyi_band_sensitivity",
      "features": ["age_years", "sex_male", "ordinal_theta_entropy", "ordinal_theta_complexity", "ordinal_theta_fisher_information", "ordinal_theta_renyi_entropy_alpha_0_1", "ordinal_theta_renyi_complexity_alpha_0_1", "ordinal_theta_renyi_entropy_alpha_10", "ordinal_theta_renyi_complexity_alpha_10", "ordinal_alpha_entropy", "ordinal_alpha_complexity", "ordinal_alpha_fisher_information", "ordinal_alpha_renyi_entropy_alpha_0_1", "ordinal_alpha_renyi_complexity_alpha_0_1", "ordinal_alpha_renyi_entropy_alpha_10", "ordinal_alpha_renyi_complexity_alpha_10", "ordinal_beta_entropy", "ordinal_beta_complexity", "ordinal_beta_fisher_information", "ordinal_beta_renyi_entropy_alpha_0_1", "ordinal_beta_renyi_complexity_alpha_0_1", "ordinal_beta_renyi_entropy_alpha_10", "ordinal_beta_renyi_complexity_alpha_10"]
    },
    "aperiodic_adjusted": {
      "label": "Aperiodic exponent + demographics",
      "role": "fit_sensitive_sensitivity",
      "features": ["age_years", "sex_male", "aperiodic_exponent"]
    },
    "bout_dynamics_adjusted": {
      "label": "Bout dynamics + demographics",
      "role": "fit_sensitive_sensitivity",
      "features": ["age_years", "sex_male", "bout_theta_oscillatory_occupancy", "bout_theta_bouts_per_minute", "bout_theta_bout_duration_mean_s", "bout_alpha_oscillatory_occupancy", "bout_alpha_bouts_per_minute", "bout_alpha_bout_duration_mean_s", "bout_low_beta_oscillatory_occupancy", "bout_low_beta_bouts_per_minute", "bout_low_beta_bout_duration_mean_s", "bout_high_beta_oscillatory_occupancy", "bout_high_beta_bouts_per_minute", "bout_high_beta_bout_duration_mean_s"]
    },
    "bout_ordinal_adjusted": {
      "label": "Within-bout ordinal + demographics",
      "role": "fit_sensitive_sensitivity",
      "features": ["age_years", "sex_male", "bout_ordinal_theta_entropy", "bout_ordinal_theta_complexity", "bout_ordinal_theta_fisher_information", "bout_ordinal_alpha_entropy", "bout_ordinal_alpha_complexity", "bout_ordinal_alpha_fisher_information", "bout_ordinal_low_beta_entropy", "bout_ordinal_low_beta_complexity", "bout_ordinal_low_beta_fisher_information", "bout_ordinal_high_beta_entropy", "bout_ordinal_high_beta_complexity", "bout_ordinal_high_beta_fisher_information"]
    },
    "typical_bout_shape_adjusted": {
      "label": "Typical-bout shape + demographics",
      "role": "fit_sensitive_sensitivity",
      "features": ["age_years", "sex_male", "typical_theta_envelope_peak_ratio", "typical_theta_envelope_half_height_width_s", "typical_theta_envelope_asymmetry", "typical_theta_relative_phase_consistency", "typical_alpha_envelope_peak_ratio", "typical_alpha_envelope_half_height_width_s", "typical_alpha_envelope_asymmetry", "typical_alpha_relative_phase_consistency", "typical_low_beta_envelope_peak_ratio", "typical_low_beta_envelope_half_height_width_s", "typical_low_beta_envelope_asymmetry", "typical_low_beta_relative_phase_consistency", "typical_high_beta_envelope_peak_ratio", "typical_high_beta_envelope_half_height_width_s", "typical_high_beta_envelope_asymmetry", "typical_high_beta_relative_phase_consistency"]
    },
    "multimodal_compact": {
      "label": "Compact multimodal EEG + demographics",
      "role": "multimodal_sensitivity",
      "features": ["age_years", "sex_male", "ordinal_global_entropy", "ordinal_global_complexity", "ordinal_global_fisher_information", "psd_log2_delta_vs_low_gamma", "psd_log2_theta_vs_low_gamma", "psd_log2_alpha_vs_low_gamma", "psd_log2_beta_vs_low_gamma", "aperiodic_exponent", "bout_theta_oscillatory_occupancy", "bout_theta_bout_duration_mean_s", "bout_alpha_oscillatory_occupancy", "bout_alpha_bout_duration_mean_s", "bout_low_beta_oscillatory_occupancy", "bout_low_beta_bout_duration_mean_s", "bout_high_beta_oscillatory_occupancy", "bout_high_beta_bout_duration_mean_s"]
    },
    "clinical_extension": {
      "label": "Ordinal + PSD + demographics + MOCA",
      "role": "clinical_extension",
      "features": ["age_years", "sex_male", "moca", "ordinal_global_entropy", "ordinal_global_complexity", "ordinal_global_fisher_information", "psd_log2_delta_vs_low_gamma", "psd_log2_theta_vs_low_gamma", "psd_log2_alpha_vs_low_gamma", "psd_log2_beta_vs_low_gamma"]
    }
  },
  "validation": {
    "outer_folds": 5,
    "outer_repeats": 10,
    "inner_folds": 4,
    "c_grid": [0.01, 0.03, 0.1, 0.3, 1.0, 3.0, 10.0, 30.0, 100.0],
    "threshold_policy": "inner_youden",
    "classification_threshold": 0.5,
    "bootstrap_resamples": 2000,
    "permutation_resamples": 200,
    "random_seed": 20260824,
    "primary_metric": "roc_auc"
  },
  "plots": {
    "dpi": 150,
    "group_order": ["PD", "Control"],
    "group_colors": {"PD": "#D55E00", "Control": "#0072B2"},
    "model_order": ["demographics", "ordinal_core", "ordinal_adjusted", "ordinal_renyi_adjusted", "ordinal_band_adjusted", "ordinal_band_renyi_adjusted", "psd_adjusted", "aperiodic_adjusted", "bout_dynamics_adjusted", "bout_ordinal_adjusted", "typical_bout_shape_adjusted", "ordinal_psd_adjusted", "multimodal_compact", "clinical_extension"]
  }
}
